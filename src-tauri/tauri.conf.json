{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumioNG",
  "version": "0.6.0",
  "identifier": "LumioNG",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "LumioNG",
        "width": 800,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "blob:",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "object-src": "blob:",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "NG",
    "homepage": "https://github.com/NGxxxx/lumioNG",
    "category": "DeveloperTool",
    "shortDescription": "Fast, table-first MongoDB GUI",
    "longDescription": "LumioNG is a free, open-source MongoDB GUI client: a virtualized data grid, visual aggregation pipeline builder, query console, live server dashboard, change-stream viewer, import/export and a built-in MCP server for AI assistants.",
    "copyright": "Copyright (C) 2025-2026 NG and LumioNG contributors",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": { "depends": ["libgssapi-krb5-2"], "section": "database" },
      "rpm": { "depends": ["krb5-libs"] }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
